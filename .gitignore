ml/models/backups/
ml/models/variant/
ml/reports/*.log
ml/reports/train_main_*.log

# Local Python virtualenvs (never commit)
.venv/
**/.venv/

# Python caches
__pycache__/
*.py[cod]
*$py.class
.Python

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
