APP_NAME=BarongClassifier
APP_ENV=development
DEBUG=true
SECRET_KEY=replace_with_a_long_random_secret
HOST=0.0.0.0
PORT=5000
BASE_URL=http://127.0.0.1:5000

# Prefer DATABASE_URL, or the split DB_* keys below.
DATABASE_URL=
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=
DB_SSLMODE=require
DB_POOL_MODE=session
SQLALCHEMY_TRACK_MODIFICATIONS=false

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=BarongClassifier
MAIL_ENCRYPTION=tls

EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_CODE_LENGTH=6
DEVICE_TRUST_DAYS=30
SESSION_COOKIE_SECURE=false

# Leave CLASSIFY_SERVER_URL empty to use the local Keras model in models/.
CLASSIFY_SERVER_URL=
MODEL_PATH=models/barong_model.keras
CLASS_NAMES=cocoon,jusi,pina
IMAGE_SIZE=224
MAX_UPLOAD_SIZE_MB=10

# Optional: upload classified images and store secure_url in classifications.image_path
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare Turnstile (login + register). Add LAN IP / localhost to widget hostnames.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
