APP_NAME=BarongClassifier
APP_ENV=development
DEBUG=true
SECRET_KEY=replace_with_a_long_random_secret
HOST=0.0.0.0
PORT=5001
BASE_URL=http://127.0.0.1:5001
OWNER_URL=http://127.0.0.1:5001

DATABASE_URL=
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=
DB_SSLMODE=require

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=BarongClassifier
MAIL_ENCRYPTION=tls

EMAIL_VERIFICATION_EXPIRE_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_CODE_LENGTH=6
PASSWORD_RESET_EXPIRE_MINUTES=10

SESSION_COOKIE_SECURE=false
ACCESS_TOKEN_EXPIRE_MINUTES=480
OWNER_ROLES=owner

# Cloudflare Turnstile (shown after login). Add LAN IP / localhost to widget hostnames.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Phase 2: standardize camera/uploads to WebP before Cloudinary + CNN.
IMAGE_STORAGE_FORMAT=WEBP
IMAGE_WEBP_QUALITY=90
IMAGE_WEBP_METHOD=6
IMAGE_WEBP_LOSSLESS=false
IMAGE_MAX_UPLOAD_MB=15
IMAGE_MAX_WIDTH=6000
IMAGE_MAX_HEIGHT=6000
MAX_UPLOAD_SIZE_MB=15

# Local CNN (Render ships this file; training datasets stay on your PC).
CLASSIFY_SERVER_URL=
MODEL_PATH=models/barong_model.keras
RELEVANCE_GATE_ENABLED=false

# Optional: upload classified images and store secure_url in classifications.image_path
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Render notes ---
# Training datasets are NOT deployed (see root .gitignore: Backend/dataset, ml/data).
# Classify uses models/barong_model.keras. Retrain only on your PC, then push the .keras.
# Set BASE_URL / OWNER_URL / CUSTOMER_URL to your https://*.onrender.com URLs.
# APP_ENV=production, DEBUG=false, USE_HTTPS=false (Render terminates TLS).
